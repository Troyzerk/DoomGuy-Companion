<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DoomGuy</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.1.0</Version>
    <Product>DoomGuy</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <!-- A small always-on widget: no background GC thread, and a heap that stays compact. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <!-- The tests are their own project (Tests\DoomGuy.Tests.csproj). -->
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Page Remove="Tests\**" />
  </ItemGroup>

  <!-- Freedoom ships beside the exe (not inside it) with its licence, so DoomGuy runs without Doom.
       tools\get-freedoom.ps1 fetches the WAD; without it the app still builds and asks for a WAD. -->
  <ItemGroup>
    <None Update="Freedoom\freedoom1.wad;Freedoom\COPYING.txt;Freedoom\CREDITS.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
